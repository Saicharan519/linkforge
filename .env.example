# Copy to `.env` (gitignored) to override the local docker-compose defaults:  cp .env.example .env
# Docker Compose reads `.env` automatically. EVERY line is optional: these are the defaults
# already built into docker-compose.yml. Throwaway LOCAL-DEV credentials (Postgres is published
# on 127.0.0.1 only). Real environments never use this file: Kubernetes gets config from the
# Helm chart and the `linkforge-db` Secret (later Sealed Secrets), see docs/SECURITY.md.

POSTGRES_USER=linkforge
POSTGRES_PASSWORD=linkforge_dev
POSTGRES_DB=linkforge

# Host ports. Change one only if something else on your machine already owns it.
POSTGRES_PORT=5432
REDIS_PORT=6379
