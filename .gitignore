!backend/certs/rds-global-bundle.pem

# Terraform (state and plans can contain secrets)
.terraform/
*.tfstate
*.tfstate.*
tfplan
*.tfplan
terraform.tfvars
*.auto.tfvars
backend.hcl
crash.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
