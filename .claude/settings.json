{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(terraform apply)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy)",
      "Bash(terraform destroy *)",
      "Bash(terraform import *)",
      "Bash(terraform state rm *)",
      "Bash(terraform force-unlock *)",
      "Bash(terraform plan)",
      "Bash(terraform plan *)",
      "Bash(terraform init)",
      "Bash(aws *)",
      "Bash(AWS_PROFILE=* *)",
      "Bash(*--profile*)",
      "Bash(*.aws/*)",
      "Bash(*.aws *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.*)",
      "Read(./**/tfplan)",
      "Read(./**/terraform.tfvars)",
      "Read(~/.aws/**)",
      "Read(**/.aws/**)",
      "Read(~/.ssh/**)"
    ]
  }
}
