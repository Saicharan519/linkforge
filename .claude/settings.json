{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(terraform apply)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy)",
      "Bash(terraform destroy *)",
      "Bash(terraform import *)",
      "Bash(terraform state rm *)",
      "Bash(terraform force-unlock *)",
      "Bash(terraform plan)",
      "Bash(terraform plan *)",
      "Bash(terraform init)",
      "Bash(aws *)",
      "Bash(AWS_PROFILE=* *)",
      "Bash(*--profile*)",
      "Bash(*.aws/*)",
      "Bash(*.aws *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.*)",
      "Read(./**/tfplan)",
      "Read(./**/terraform.tfvars)",
      "Read(~/.aws/**)",
      "Read(**/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.sealed-secrets-backup/**)",
      "Read(**/.sealed-secrets-backup/**)",
      "Bash(kubectl --kubeconfig*)",
      "Bash(kubectl *--kubeconfig*)",
      "Bash(helm *--kubeconfig*)",
      "Bash(*KUBECONFIG=*)",
      "Bash(kubectl --context *eks*)",
      "Bash(kubectl *--context *eks*)",
      "Bash(helm *--kube-context *eks*)",
      "Bash(kubectl config use-context*)",
      "Bash(kubectl config set-context*)",
      "Bash(*linkforge-eks*)",
      "Read(~/.kube/linkforge-eks*)",
      "Read(**/.kube/linkforge-eks*)",
      "Bash(*bootstrap-eks.sh*)",
      "Bash(*eks-seal-and-enable.sh*)",
      "Bash(*eks-set-hosts.sh*)",
      "Bash(*eks-verify.sh*)",
      "Bash(*eks-teardown.sh*)",
      "Bash(*eks-fix-webhook-ca.sh*)",
      "Bash(*eks-reset-gitops.sh*)",
      "Bash(terraform output*)",
      "Bash(terraform show*)",
      "Bash(terraform state *)",
      "Bash(terraform console*)",
      "Bash(terraform -chdir=* apply*)",
      "Bash(terraform -chdir=* destroy*)",
      "Bash(terraform -chdir=* plan*)",
      "Bash(terraform -chdir=* import*)",
      "Bash(terraform -chdir=* force-unlock*)",
      "Bash(terraform -chdir=* state *)",
      "Bash(terraform -chdir=* output*)",
      "Bash(terraform -chdir=* show*)",
      "Bash(terraform -chdir=* console*)",
      "Bash(terraform -chdir=* init)",
      "Bash(terraform *init *-backend-config*)"
    ]
  }
}
